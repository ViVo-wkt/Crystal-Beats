--- !u!114 &409877453
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 409877451}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Beneath every great city of the dwarven clans - lies an entire realm,
    deep inside the earth\u2019s crust. It is a mine, dug greedily in the prospect
    for resources. Under one of the cities, however, a new type of ore had been discovered,
    unlike any other. Veins of glowing crystal: When struck, it sang. When heated,
    it pulsed. When shattered, it released energy beyond comprehension. The engineers,
    with their great old minds, studied it and whispered among themselves theories
    of sonic resonance fields - that all matter vibrates at unique frequencies, and
    the crystals were simply amplifiers of this cosmic hum. Some even claimed they
    could manipulate reality itself, bending time and space with the right harmonic
    sequence. But for the longest time, the crystals were only studied shallowly,
    their properties being harnessed for machines, weapons and various automata.\r"
