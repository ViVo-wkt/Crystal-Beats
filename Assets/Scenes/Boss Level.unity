  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Each crystal you collected brought you closer to understanding the truth,
    you didn\u2019t only feel it, but could even see it: the pile they were being
    stacked upon inside the resonance core began to attract lesser clumps. When they
    merged with the main mass, the whole system pulsed with yet untapped energy.
    There was an issue, however. The machine seemed less stable than originally intended.
    Seems like the replacement that had been done was not entirely without consequence.
    No matter - you continued. Until one day. When you came from the mines, carrying
    a bunch of crystals in your bag, it jumped up when you as much as came close
    to the machine. Its contents shot out of it, and flew inside the core. In an
    instant, reality around you has begun to warp itself."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: aa9690349e011964aaa78700753f6328, type: 2}
  m_sharedMaterial: {fileID: -5494141874244254509, guid: aa9690349e011964aaa78700753f6328, type: 2}
